# ==============================================================================
# Pocket 3D Showcase - Backend & AI Worker Configuration
# ==============================================================================

APP_NAME="Pocket 3D Showcase API"
APP_ENV="development"
HOST="0.0.0.0"
PORT=8000
PUBLIC_BASE_URL="http://localhost:8000"

# ------------------------------------------------------------------------------
# AI Background Removal & Auto-Centering (FR-04, NFR-01, NFR-02)
# ------------------------------------------------------------------------------
# Options: "u2netp" (Fastest ONNX <10s), "u2net", "birefnet-general-lite", "studio_GrabCut"
AI_MODEL_NAME="u2netp"
# Fallback automatically to fast OpenCV alpha matting if ONNX model weights are not cached yet
AI_AUTO_FALLBACK=true
# Output square resolution (px) for 360 WebP package
OUTPUT_CANVAS_SIZE=800
# Object fill ratio (0.82 = 82% of canvas across global max bounding box)
GLOBAL_SCALE_FILL_RATIO=0.82
# WebP quality (1-100) tuned to keep 36 frames within 1.5MB - 3.0MB (NFR-02)
WEBP_QUALITY=82
MAX_WORKERS=4

# ------------------------------------------------------------------------------
# Queue Backend (FR-03: Hybrid Local ThreadPool or Redis Queue)
# ------------------------------------------------------------------------------
# Options: "local" | "redis"
QUEUE_BACKEND="local"
REDIS_URL="redis://localhost:6379/0"
REDIS_QUEUE_NAME="pocket3d_jobs"

# ------------------------------------------------------------------------------
# Storage Backend (NFR-04: Hybrid Local Storage or AWS S3 / Cloudflare R2)
# ------------------------------------------------------------------------------
# Options: "local" | "s3"
STORAGE_BACKEND="local"
S3_ENDPOINT_URL="https://<account_id>.r2.cloudflarestorage.com"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME="pocket-3d-showcase"
S3_REGION="auto"
S3_PUBLIC_DOMAIN="https://cdn.example.com"
